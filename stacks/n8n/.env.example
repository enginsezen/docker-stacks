########################################
# Container Images
########################################

# Image versions used by this stack.
# These values are maintained by this repository.

N8N_VERSION=2.34.0
POSTGRES_VERSION=16.10-alpine
REDIS_VERSION=7.4.5-alpine

########################################
# General
########################################

# Time zone used by n8n.
#
# Examples:
#   Europe/Istanbul
#   Europe/Berlin
#   America/New_York

TZ=Europe/Istanbul

########################################
# n8n
########################################

# Public URL of your n8n instance.
#
# Example:
# https://n8n.example.com

N8N_HOST=n8n.example.com

# Basic Authentication username.

N8N_BASIC_AUTH_USER=admin

# Generate a secure password:
#
# openssl rand -base64 32

N8N_BASIC_AUTH_PASSWORD=change-me

# Generate a secure encryption key:
#
# openssl rand -hex 32

N8N_ENCRYPTION_KEY=change-me

########################################
# SMTP
########################################

# SMTP server configuration.
#
# Examples:
# Gmail:
#   Host: smtp.gmail.com
#   Port: 587
#
# Microsoft 365:
#   Host: smtp.office365.com
#   Port: 587
#
# Mailcow:
#   Host: mail.example.com
#   Port: 587

N8N_SMTP_HOST=smtp.example.com
N8N_SMTP_PORT=587
N8N_SMTP_SSL=false

N8N_SMTP_USER=user@example.com

# SMTP account password.

N8N_SMTP_PASS=change-me

# Sender address used by n8n.

N8N_SMTP_SENDER=n8n@example.com

########################################
# PostgreSQL
########################################

# These values normally do not need to be changed.

POSTGRES_DB=n8n
POSTGRES_USER=n8n

# Generate a secure password:
#
# openssl rand -base64 32

POSTGRES_PASSWORD=change-me
